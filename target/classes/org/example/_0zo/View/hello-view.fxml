<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="609.0" prefWidth="609.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example._0zo.Controller.GameController">
    <children>
        <ImageView fitHeight="612.0" fitWidth="616.0" layoutX="-1.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@imagenes/BackScreen.jpg" />
            </image>
        </ImageView>

        <Button alignment="CENTER" layoutX="557.0" layoutY="13.0" mnemonicParsing="false"
                prefHeight="35.0" prefWidth="33.0"
                style="-fx-background-radius: 70; -fx-background-color: blue;"
                text="?" textFill="WHITE">
            <font>
                <Font name="Consolas" size="20.0" />
            </font>
        </Button>

        <Label fx:id="lblTableSum" layoutX="262.0" layoutY="153.0"
               style="-fx-border-color: WHITE;"
               text="Suma: 0" textFill="WHITE">
            <font>
                <Font name="Consolas" size="22.0" />
            </font>
            <effect>
                <DropShadow>
                    <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                    </color>
                </DropShadow>
            </effect>
        </Label>

        <Label fx:id="lblCurrentCard" layoutX="200.0" layoutY="190.0"
               text="Mesa vacía" textFill="WHITE">
            <font>
                <Font name="Consolas" size="16.0" />
            </font>
        </Label>

        <Label fx:id="lblPlayerTurn" layoutX="200.0" layoutY="120.0"
               text="Turno de: Humano" textFill="#90EE90">
            <font>
                <Font name="Consolas" size="18.0" />
            </font>
            <effect>
                <DropShadow>
                    <color>
                        <Color red="0.0" green="1.0" blue="0.0" />
                    </color>
                </DropShadow>
            </effect>
        </Label>

        <ImageView fx:id="imgActiveCard" fitHeight="128.0" fitWidth="87.0"
                   layoutX="219.0" layoutY="231.0"
                   pickOnBounds="true" preserveRatio="true"
                   visible="false">
        </ImageView>

        <ImageView fitHeight="128.0" fitWidth="87.0"
                   layoutX="306.0" layoutY="231.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@imagenes/back.png" />
            </image>
        </ImageView>

        <VBox layoutX="13.0" layoutY="95.0" prefHeight="400.0" prefWidth="0.0" />
        <VBox layoutX="594.0" layoutY="95.0" prefHeight="400.0" prefWidth="0.0" />

        <HBox layoutX="105.0" layoutY="13.0" prefHeight="0.0" prefWidth="400.0" />

        <HBox fx:id="playerHandContainer" layoutX="105.0" layoutY="454.0"
              prefHeight="140.0" prefWidth="400.0"
              alignment="CENTER" spacing="10"
              style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 10;">
        </HBox>

    </children>
</AnchorPane>